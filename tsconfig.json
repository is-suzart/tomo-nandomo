{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@nandomo/bridge-gtk",
    "useDefineForClassFields": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@nandomo/core": ["./packages/core/src/index.ts"],
      "@nandomo/bridge-runtime/*": ["./packages/bridge-runtime/src/*"],
      "@nandomo/bridge-gtk": ["./packages/bridge-gtk/src/index.ts"],
      "@nandomo/bridge-gtk/*": ["./packages/bridge-gtk/src/*"]
    }
  },
  "include": ["src/**/*", "packages/**/*"]
}
